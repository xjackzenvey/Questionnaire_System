# Requires APP_BASE_PATH=/questions at both build time and runtime.
server {
    listen 80;
    server_name app.chisato.space;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name app.chisato.space;
    ssl_certificate /etc/letsencrypt/live/app.chisato.space/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.chisato.space/privkey.pem;
    client_max_body_size 2m;

    location = /questions {
        return 308 /questions/;
    }
    location /questions/ {
        # No trailing slash: preserve the deployment prefix for Node.
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    # Add other applications' locations here as needed.
}
